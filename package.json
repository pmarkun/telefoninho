{
  "name": "telefoninho",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @telefoninho/api dev",
    "dev:web": "pnpm --filter @telefoninho/parent-web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:push": "pnpm --filter @telefoninho/api db:push",
    "seed": "pnpm --filter @telefoninho/api seed",
    "infra:generate-asterisk": "pnpm --filter @telefoninho/api generate:asterisk",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "pnpm": "^10.11.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
